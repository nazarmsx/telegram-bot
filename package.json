{
  "name": "telegram-bot",
  "version": "0.1.0",
  "description": "Telegram bot",
  "engines": {
    "node": ">=21.0.0"
  },
  "scripts": {
    "start": "npm run serve",
    "build": "npm run build-ts",
    "serve": "node dist/server.js",
    "start:bot": "cross-env NODE_ENV=kyivbot node dist/bot.js",
    "watch-node": "nodemon dist/server.js",
    "test": "jest --forceExit --coverage --verbose --passWithNoTests",
    "watch-test": "npm run test -- --watchAll",
    "build-ts": "tsc",
    "watch-ts": "tsc -w"
  },
  "overrides": {
    "tar": "^7.5.13"
  },
  "dependencies": {
    "async": "^3.2.6",
    "await-to-js": "^3.0.0",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bluebird": "^3.7.2",
    "body-parser": "^1.20.3",
    "compression": "^1.7.5",
    "cross-env": "^7.0.3",
    "date-fns": "^2.30.0",
    "dotenv": "^16.4.7",
    "errorhandler": "^1.5.1",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "lusca": "^1.7.0",
    "moment": "^2.30.1",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "viber-bot": "^1.0.16",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/async": "^3.2.24",
    "@types/bcrypt": "^5.0.2",
    "@types/bluebird": "^3.5.42",
    "@types/body-parser": "^1.19.5",
    "@types/chai": "^4.3.20",
    "@types/compression": "^1.7.5",
    "@types/errorhandler": "^1.5.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.13",
    "@types/lusca": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "chai": "^4.5.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "shelljs": "^0.8.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
